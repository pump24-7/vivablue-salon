{
  "expo": {
    "name": "Viva Blue Salon",
    "slug": "viva-blue-salon",
    "scheme": "vivablue",
    "version": "0.3.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker"
    ],
    "ios": {
      "bundleIdentifier": "com.vivabluesalon.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vivabluesalon.app"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
