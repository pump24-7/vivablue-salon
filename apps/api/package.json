{
  "name": "@vivablue/api",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "seed:dev": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx ../../scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0",
    "luxon": "^3.7.0",
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/luxon": "^3.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
