# Server-only secrets. Never prefix auth client secret, API origin or cookie secret with NEXT_PUBLIC.
VIVABLUE_API_ORIGIN=http://localhost:4000
VIVABLUE_APP_ORIGIN=http://localhost:3000
VIVABLUE_OIDC_ISSUER=https://YOUR_ORGANIZATION_IDENTITY_PROVIDER/
VIVABLUE_OIDC_CLIENT_ID=YOUR_ADMIN_OIDC_CLIENT_ID
VIVABLUE_OIDC_CLIENT_SECRET=
VIVABLUE_COOKIE_SECRET=replace-with-at-least-32-random-characters
